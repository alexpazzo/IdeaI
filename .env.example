# IdeaI — contratto di configurazione (Appendice A del documento di architettura).
# Copia questo file in `.env` e valorizza i segreti. Precedenza di risoluzione (§10.4):
#   1. variabile d'ambiente esplicita  2. profilo `IDEAI_HARDWARE_PROFILE`  3. default nel codice.
# I default qui sotto sono quelli del profilo `gpu-8gb`.

# --- Ambiente e log -----------------------------------------------------------------
IDEAI_ENV=dev
IDEAI_LOG_LEVEL=INFO

# --- Stato e API --------------------------------------------------------------------
# Dentro il Compose l'host è `postgres`; da fuori (test locali) usa 127.0.0.1:5432.
IDEAI_DATABASE_URL=postgresql+asyncpg://ideai:ideai@postgres:5432/ideai
# OBBLIGATORIA: bearer token accettato dall'API. Genera con: openssl rand -hex 32
IDEAI_API_KEY=change-me
IDEAI_API_BASE_URL=http://api:8000
# OBBLIGATORIA: salt per lo sha256 degli autori. Genera con: openssl rand -hex 16
IDEAI_SALT=change-me

# --- Reddit (obbligatorie solo con una sorgente `reddit` abilitata) ------------------
# Crea una app "script" su https://www.reddit.com/prefs/apps
IDEAI_REDDIT_CLIENT_ID=
IDEAI_REDDIT_CLIENT_SECRET=
# Formato obbligatorio: ideai/<versione> by /u/<owner>
IDEAI_REDDIT_USER_AGENT=
IDEAI_REDDIT_RPM=100
IDEAI_PULLPUSH_RPM=60

# --- Ingestion e coda ---------------------------------------------------------------
IDEAI_SCRAPE_PAGE_SIZE=100
IDEAI_DEFAULT_POLL_INTERVAL_S=300
IDEAI_RATE_LIMIT_WINDOW_S=60
IDEAI_JOB_LEASE_S=120
IDEAI_JOB_HEARTBEAT_S=30
IDEAI_MAX_ATTEMPTS=5
IDEAI_JOB_RETENTION_DAYS=7
IDEAI_SCHEDULER_TICK_S=30
IDEAI_WORKER_CONCURRENCY=4

# --- Inferenza ----------------------------------------------------------------------
# Il backend `local` usa l'endpoint nativo Ollama: `format` con JSON Schema vincola il
# decoding, che è ciò che rende rispettato lo schema di triage. Fuori dal Compose usa
# http://127.0.0.1:11434 (senza /v1).
# NOTA (Linux, dentro il Compose): i container raggiungono Ollama via
# host.docker.internal, quindi Ollama deve ascoltare anche fuori dal loopback:
#   OLLAMA_HOST=0.0.0.0:11434   (vedi README, sezione "Note operative")
# Con il profilo `local-llm` usa invece http://ollama:11434.
IDEAI_LLM_BACKENDS={"local":{"type":"ollama_native","base_url":"http://127.0.0.1:11434","api_key_env":null,"timeout_s":120,"max_concurrency":2,"rpm":null},"deepseek":{"type":"openai_compat","base_url":"https://api.deepseek.com/v1","api_key_env":"DEEPSEEK_API_KEY","timeout_s":60,"max_concurrency":4,"rpm":null},"anthropic":{"type":"anthropic","base_url":"https://api.anthropic.com","api_key_env":"ANTHROPIC_API_KEY","timeout_s":60,"max_concurrency":4,"rpm":null}}
# Prezzi per milione di token, per model_spec `<backend>/<model>` (i locali valgono 0).
IDEAI_LLM_PRICES={"deepseek/deepseek-chat":{"in":0.27,"out":1.10}}
IDEAI_LLM_DAILY_BUDGET_USD=5.00
IDEAI_LLM_CACHE_MAX_AGE_DAYS=30

# Modelli: `<backend>/<model>`. Il default del documento (`local/minicpm4:8b-q4_K_M`) non
# esiste nel registry Ollama, quindi qui si usa `qwen3:8b` (vedi divergenza 1 del piano).
IDEAI_TRIAGE_MODEL=local/qwen3:8b
IDEAI_ANALYST_MODEL=local/qwen3:8b
IDEAI_EMBED_MODEL=local/bge-m3:567m
IDEAI_EMBED_DIM=1024

# --- Pipeline e scoring -------------------------------------------------------------
IDEAI_TRIAGE_BATCH=10
IDEAI_DUP_SIM_HIGH=0.92
IDEAI_DUP_SIM_LOW=0.80
IDEAI_G0_WINDOW_DAYS=7
IDEAI_ANALYSIS_MAX_EVIDENCE=20
IDEAI_QUOTE_MAX_CHARS=280
IDEAI_RETENTION_DAYS=30

# --- Watch --------------------------------------------------------------------------
IDEAI_WATCH_THRESHOLD=70
IDEAI_WATCH_MIN_DELTA=3
IDEAI_WATCH_MIN_INTERVAL_S=900
IDEAI_WATCH_MAX_INTERVAL_S=86400
IDEAI_WATCH_EXPIRE_DAYS=30

# --- Hardware -----------------------------------------------------------------------
# `cpu` | `gpu-8gb` | `gpu-16gb+` | `cloud`: cambia solo il default di IDEAI_ANALYST_MODEL.
IDEAI_HARDWARE_PROFILE=gpu-8gb

# --- Chiavi dei backend cloud (lette solo se il backend è selezionato) --------------
# DEEPSEEK_API_KEY=
# ANTHROPIC_API_KEY=
